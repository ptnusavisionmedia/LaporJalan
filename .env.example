# ---------- Mobile (public, safe to bundle) ----------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
ANDROID_PACKAGE=id.laporjalan.app
EAS_PROJECT_ID=

# ---------- Admin web (public, safe to bundle) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Server only: NEVER prefix with EXPO_PUBLIC_ / NEXT_PUBLIC_ ----------
SUPABASE_SERVICE_ROLE_KEY=
AI_SERVICE_INTERNAL_TOKEN=      # shared by the AI service and the `analyze` Edge Function
AI_SERVICE_URL=                 # Edge Function secret, e.g. https://ai.example.com
PUSH_INTERNAL_TOKEN=            # protects the `send-push` Edge Function
CRON_INTERNAL_TOKEN=            # protects `cleanup-storage` and `process-deletions`
DELETION_GRACE_DAYS=7
# FCM credentials are uploaded to EAS (`eas credentials`), not kept in this repo or the app.
MODEL_PATH=models/damage.pt
MODEL_VERSION=
